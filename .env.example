# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored — never commit real secrets.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# MySQL
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=smartcampus

# Email (Gmail SMTP) for forgot username/password.
# Set MAIL_ENABLED=true once MAIL_USER/MAIL_PASS are filled.
# MAIL_PASS must be a Gmail "App Password" (enable 2-Step Verification first).
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
